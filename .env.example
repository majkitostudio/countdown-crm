# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Gemini credential. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TRAINING_MODEL=gemini-3.6-flash

# Server-only OpenAI credential for the Call Trainer. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
# Optional: override the default low-latency trainer model.
OPENAI_TRAINING_MODEL=gpt-5.4-mini
# Primary trainer provider: gemini (default) or openai.
TRAINING_AI_PROVIDER=gemini

# Server-only Telnyx credentials. WebRTC stays in simulation mode until enabled.
TELNYX_API_KEY=your-telnyx-api-key
TELNYX_CONNECTION_ID=your-telnyx-connection-id
TELNYX_DEFAULT_CALLER_NUMBER=+420000000000
TELNYX_PUBLIC_KEY=your-telnyx-webhook-public-key
NEXT_PUBLIC_TELNYX_ENABLED=false
# Optional recorded evidence for Workspace Readiness. Keep unset until the
# linked migration history has been verified; never use this as a substitute
# for the actual migration/schema check.
# WORKSPACE_MIGRATION_STATUS=verified
# WORKSPACE_MIGRATION_VERIFIED_AT=2026-09-06T20:00:00.000Z
# Optional RLS/role-matrix evidence, only after a real negative-access check.
# WORKSPACE_ROLE_BOUNDARY_STATUS=verified
# WORKSPACE_ROLE_BOUNDARY_VERIFIED_AT=2026-09-06T20:00:00.000Z
# Set only after the assigned Telnyx number has passed external verification.
# TELNYX_NUMBER_VERIFIED=false

# Development-only escape hatch for the local demo shell.
# Keep false or unset in every shared/staging/production environment.
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false

# Trusted-only test Team Leader provisioning script; never expose these keys
# through NEXT_PUBLIC_ variables or a browser bundle.
# SUPABASE_SECRET_KEY=sb_secret_...
# TEST_TEAM_LEADER_WORKSPACE_ID=workspace-uuid
# TEST_TEAM_LEADER_EMAIL=test-team-leader@example.test
# TEST_TEAM_LEADER_PASSWORD=use-a-local-secret-with-8-or-more-characters
# TEST_TEAM_LEADER_FULL_NAME=Test Team Leader

# P0.3 read-only linked database evidence runner. Create a scoped token outside
# the repository and inject it only at runtime; never use an app service-role
# key here and never prefix the token with NEXT_PUBLIC_.
# P0_3_LINKED_PROJECT_REF=linked-sandbox-project-ref
# SUPABASE_ACCESS_TOKEN=scoped-database-and-data-api-config-read-token
