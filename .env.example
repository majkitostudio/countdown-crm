# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only Gemini credential. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key
GEMINI_TRAINING_MODEL=gemini-3.6-flash

# Server-only OpenAI credential for the Call Trainer. Never prefix this with NEXT_PUBLIC_.
OPENAI_API_KEY=your-openai-api-key
# Optional: override the default low-latency trainer model.
OPENAI_TRAINING_MODEL=gpt-5.4-mini
# Primary trainer provider: gemini (default) or openai.
TRAINING_AI_PROVIDER=gemini

# Development-only escape hatch for the local demo shell.
# Keep false or unset in every shared/staging/production environment.
NEXT_PUBLIC_ALLOW_DEMO_AUTH=false

# Trusted-only test Team Leader provisioning script; never expose these keys
# through NEXT_PUBLIC_ variables or a browser bundle.
# SUPABASE_SECRET_KEY=sb_secret_...
# TEST_TEAM_LEADER_WORKSPACE_ID=workspace-uuid
# TEST_TEAM_LEADER_EMAIL=test-team-leader@example.test
# TEST_TEAM_LEADER_PASSWORD=use-a-local-secret-with-8-or-more-characters
# TEST_TEAM_LEADER_FULL_NAME=Test Team Leader
